00010 ' ====================================
00020 ' ALIEMINATION
00030 ' MANOEL NETO 2026
00040 ' ====================================
00050 COLOR 15,1,1
00060 KEY OFF:CLS:DEFINT A-Z
00070 BLOAD"XBASIC.BIN",R
00080 DEFUSR1=&H41 : ' FUNCAO DESLIGA TELA
00090 DEFUSR2=&H44 : ' FUNCAO LIGA TELA
00100 DIM EX(5,11),EY(5,11)
00110 ' ======== SPLASH SCREEN    ==========
00120 SCREEN 1,2
00130 LOCATE 6,8:? "SPACE INVADERS"
00140 LOCATE 4,9:? "PRESS FIRE TO START"
00150 LOCATE 6,10:? "MANOEL NETO 2026"
00160 OP$=INPUT$(1)
00170 CLS

00200 ' ======== INICIALIZA JOGO ===========
00220 AL=1:CA=2:LA=1:DR=1
00230 TC=0:TX=0:TY=0:CC=0
00240 HX=127:HY=174:HV=16 
00250 GOSUB 6000 : ' TABELA DE PADROES
00260 GOSUB 7000 : ' TABELA DE CORES
00270 GOSUB 8000 : ' TABELA DE SPRITES
00280 ' ======= POSICIONA OS ALIENS =======
00290 FOR I = 0 TO 4
00300    FOR J = 0 TO 10
00310        EX(I,J)=(J+1)*CA
00320        EY(I,J)=LA+I
00330    NEXT J
00340 NEXT I

00500 ' ======= METODO UPDATE =========
00510 CALL TURBO ON (EX(),EY(),HX,HY,HV,TC,TX,TY,CC)
00520 IF CC=7 THEN DR=-1:LA=LA+1
00530 IF CC=0 THEN DR=1:LA=LA+1
00540 IF LA>=20 THEN 3010
00542 ' === COLISAO ALIEN x CANHAO (CANHAO OCUPA COLUNAS HX\8 E HX\8+1, LINHA 21) ===
00543 GV=0:HC=HX\8
00544 FOR I=0 TO 4
00545    FOR J=0 TO 10
00546       IF EX(I,J)>=HC AND EX(I,J)<=HC+1 AND EY(I,J)>=21 THEN GV=1
00547    NEXT J
00548 NEXT I
00549 IF GV=1 THEN 3010
00550 IF TC=1 THEN 1000
00560 JS=STICK(0)  
00570 IF JS = 3 THEN 600
00580 IF JS = 7 THEN 610
00590 GOTO 620 
00600 HX=HX+HV:GOTO 620
00610 HX=HX-HV
00620 IF HX<0 THEN HX=0
00630 IF HX>239 THEN HX=239
00650 IF AL=2 THEN AL=1 ELSE AL=2 
00660 CC=CC+DR
00670 ' ============ METODO DRAW ===========
00680 A=USR1(0) 
00690 FOR I = 0 TO 4
00700    FOR J = 0 TO 10
00710       CL=EX(I,J):IF CL<0 THEN 780
00715       LN=EY(I,J)
00720       VPOKE &H1800+CL+LN*32,0
00730       CL=CL+DR
00740       LN=LA+I
00750       VPOKE &H1800+CL+LN*32,AL
00760       EX(I,J)=CL
00770       EY(I,J)=LN
00780    NEXT J
00790 NEXT I
00800 IF TC=1 THEN VPOKE &H1800+(TX\8)+(TY\8)*32,3 : 'TORPEDO
00810 PUT SPRITE 0,(HX,HY),6,0 : 'CANHAO
00820 A=USR2(1)
00840 ' ========== FRAME ==========
00850 TIME=0
00855 ' LE O TIRO DURANTE A ESPERA DO FRAME
00860 IF TC=0 THEN IF STRIG(0) THEN GOSUB 2000
00865 IF TIME<60 THEN 860
00870 GOTO 520

01000 ' === MOVE O TORPEDO 32 PIXELS PARA CIMA
01005 VPOKE &H1800+(TX\8)+(TY\8)*32,0
01010 TY=TY-32
01020 IF TY<0 THEN TC=0:TY=-100:GOTO 560
01030 ' === VERIFICA COLISAO COM ALIENS ====
01040 QC=TX\8:QR=TY\8
01050 FOR CI=0 TO 4
01060    FOR CJ=0 TO 10
01070       IF TC=1 AND EX(CI,CJ)=QC AND EY(CI,CJ)>=QR AND EY(CI,CJ)<=QR+4 THEN GOSUB 1200
01080    NEXT CJ
01090 NEXT CI
01100 GOTO 560

01200 ' === REMOVE ALIEN E TORPEDO ====
01210 VPOKE &H1800+EX(CI,CJ)+EY(CI,CJ)*32,0
01220 EX(CI,CJ)=-1:TC=0:TY=-100
01230 RETURN

02000 ' ======== ADICIONA TORPEDO =========
02010 TC=1:TX=HX:TY=HY-10
02020 VPOKE &H1800+(TX\8)+(TY\8)*32,3
02030 RETURN

03000 ' ======== FINALIZA TURBO =========
03010 CALL TURBO OFF
03020 GOTO 5000

05000 ' ====================================
05010 ' FIM DO JOGO
05020 ' ====================================
05030 CLS
05040 LOCATE 6,8:? "GAME OVER"
05050 LOCATE 4,9:? "PRESS ENTER TO PLAY AGAIN"
05055 OP$=INKEY$:IF OP$<>"" OR STRIG(0) THEN 5055 : ' LIMPA BUFFER E ESPERA SOLTAR A TECLA
05060 OP$=INPUT$(1)
05065 IF OP$<>CHR$(13) THEN 5060
05070 GOTO 110

06000 ' ====================================
06010 ' CARREGA A TABELA DE PADROES 
06020 ' ====================================
06030 RESTORE 9000
06040 S=0 
06050 READ R$
06060 IF R$="*" THEN RETURN ELSE VPOKE S,VAL("&H"+R$):S=S+1
06070 GOTO 6050

07000 ' ====================================
07010 ' CARREGA A TABELA DE CORES  
07020 ' ====================================
07030 FOR I=0 TO 31
07040   VPOKE &H2000+I,32
07050 NEXT I
07060 RETURN 

08000 ' ====================================
08010 ' CARREGA TABELA DE PADROES DE SPRITES
08020 ' ====================================
08030 RESTORE 10000
08040 S=BASE(9)
08050 READ R$
08060 IF R$="*" THEN RETURN ELSE VPOKE S,VAL("&H"+R$):S=S+1
08070 GOTO 8050

09000 ' ====================================
09010 ' SOFT SPRITES           
09020 ' ====================================
09030 ' ALIENS - COLOR 7
09040 DATA 00,00,00,00,00,00,00,00
09050 DATA 18,3C,7E,DB,FF,24,5A,A5
09060 DATA 18,3C,7E,DB,FF,5A,81,42
09070 ' TORPEDO - COLOR 8
09080 DATA 00,00,18,18,18,18,00,00
09090 DATA *

10000 ' ====================================
10010 ' HARD SPRITES
10020 ' ====================================
10030 ' CANHAO - COLOR 6
10040 DATA 00,00,00,00,00,00,00,00
10050 DATA 01,01,07,07,1F,1F,7F,7F
10060 DATA 00,00,00,00,00,00,00,00
10070 DATA 80,80,E0,E0,F8,F8,FE,FE
10130 DATA *